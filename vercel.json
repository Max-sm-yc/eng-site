{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "modern",
  "headers": [
    {
      "source": "/(.*\\.wasm)",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*\\.swf)",
      "headers": [
        { "key": "Content-Type", "value": "application/x-shockwave-flash" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
